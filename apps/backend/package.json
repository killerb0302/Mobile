{
  "name": "call-scheduler-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/pipeline/local/static && cp src/pipeline/local/static/index.html dist/pipeline/local/static/index.html",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "trigger-call": "tsx src/call/trigger.ts",
    "prerender-audio": "tsx src/pipeline/prerender.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@deepgram/sdk": "^3.9.0",
    "@fastify/formbody": "^8.0.1",
    "@fastify/websocket": "^11.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "twilio": "^5.3.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
