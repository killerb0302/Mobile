# Which mode to run: "twilio" (real paid phone calls) or "local" (free,
# offline, browser push-to-talk demo). Defaults to "twilio". Only the
# section below matching your chosen mode needs to be filled in.
VOICE_AGENT_MODE=twilio

# Local port the server listens on. Defaults to 3000.
PORT=3000

# =============================================================================
# Twilio mode (VOICE_AGENT_MODE=twilio) - real outbound calls, paid accounts
# =============================================================================

# Twilio (Programmable Voice) - https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be E.164 format, e.g. +15551234567 - a number you've purchased in your Twilio account.
TWILIO_PHONE_NUMBER=

# Anthropic API - https://console.anthropic.com (separate from a Claude.ai subscription, billed per-token)
ANTHROPIC_API_KEY=

# Deepgram (speech-to-text) - https://console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs (text-to-speech) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# A voice ID from your ElevenLabs voice library (Voices tab -> copy ID).
ELEVENLABS_VOICE_ID=

# Public HTTPS URL Twilio will call back to for webhooks and the Media
# Stream WebSocket (wss:// is derived from this automatically). During local
# development, point this at an ngrok/Cloudflare Tunnel URL, e.g.
# https://abc123.ngrok-free.app - it must be reachable from the public
# internet since Twilio's servers call it, not your machine.
PUBLIC_BASE_URL=

# Spoken in the fixed disclosure line ("...calling on behalf of <name>...").
# Defaults to "the caller" if unset.
CALLER_NAME=

# =============================================================================
# Local mode (VOICE_AGENT_MODE=local) - $0, offline, no accounts, no trials.
# See the README's "Free local mode" section for how to install/run each of
# these. All three (whisper.cpp server, Ollama, Piper) must be reachable at
# the URLs/paths below before the local server will work end to end - the
# server fails fast at startup if OLLAMA_MODEL/PIPER_BINARY_PATH/
# PIPER_VOICE_MODEL_PATH aren't set, and at first use if the whisper.cpp
# server or Ollama aren't actually reachable.
# =============================================================================

# Base URL of a running whisper.cpp `server` instance. Defaults to
# http://localhost:8080 (its default port).
WHISPER_SERVER_URL=http://localhost:8080

# Base URL of a running Ollama instance. Defaults to http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434
# A model you've already pulled (ollama pull <model>), e.g. llama3.2:3b or
# phi3:mini for lower-RAM machines.
OLLAMA_MODEL=

# Path to the piper executable, and to a voice .onnx model file you've
# downloaded (see README). E.g. /usr/local/bin/piper and
# /home/you/piper-voices/en_US-lessac-medium.onnx
PIPER_BINARY_PATH=
PIPER_VOICE_MODEL_PATH=
# The sample rate (Hz) your chosen Piper voice model outputs at - check the
# voice's .onnx.json config file's "sample_rate" field. Defaults to 22050
# (common for Piper's medium-quality voices).
PIPER_SAMPLE_RATE=22050
