# Twilio (Programmable Voice) - https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be E.164 format, e.g. +15551234567 - a number you've purchased in your Twilio account.
TWILIO_PHONE_NUMBER=

# Anthropic API - https://console.anthropic.com (separate from a Claude.ai subscription, billed per-token)
ANTHROPIC_API_KEY=

# Deepgram (speech-to-text) - https://console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs (text-to-speech) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# A voice ID from your ElevenLabs voice library (Voices tab -> copy ID).
ELEVENLABS_VOICE_ID=

# Public HTTPS URL Twilio will call back to for webhooks and the Media
# Stream WebSocket (wss:// is derived from this automatically). During local
# development, point this at an ngrok/Cloudflare Tunnel URL, e.g.
# https://abc123.ngrok-free.app - it must be reachable from the public
# internet since Twilio's servers call it, not your machine.
PUBLIC_BASE_URL=

# Local port the server listens on. Defaults to 3000.
PORT=3000

# Spoken in the fixed disclosure line ("...calling on behalf of <name>...").
# Defaults to "the caller" if unset.
CALLER_NAME=
